{
    "name": "lmottasin/laravel-http-mailer",
    "description": "Send Laravel mail through SendGrid and Brevo HTTP APIs (port 443) when SMTP ports are blocked.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mail",
        "mailer",
        "sendgrid",
        "brevo",
        "sendinblue",
        "smtp",
        "http-api",
        "transport"
    ],
    "homepage": "https://github.com/lmottasin/laravel-http-mailer",
    "support": {
        "issues": "https://github.com/lmottasin/laravel-http-mailer/issues",
        "source": "https://github.com/lmottasin/laravel-http-mailer"
    },
    "authors": [
        {
            "name": "lmottasin",
            "email": "lmottasin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
        "symfony/http-client": "^7.0 || ^8.0",
        "symfony/sendgrid-mailer": "^7.0 || ^8.0",
        "symfony/brevo-mailer": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Lmottasin\\HttpMailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lmottasin\\HttpMailer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lmottasin\\HttpMailer\\HttpMailerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always"
    },
    "config": {
        "sort-packages": true
    }
}
