{
    "name": "lmottasin/laravel-http-mailer",
    "description": "Send Laravel mail through the SendGrid or Brevo HTTP API (port 443) when SMTP ports 25, 465 and 587 are blocked on DigitalOcean, AWS, Google Cloud or Hetzner. No code changes.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-mail",
        "mail",
        "email",
        "transactional-email",
        "mailer",
        "mail-driver",
        "mail-transport",
        "sendgrid",
        "brevo",
        "sendinblue",
        "smtp",
        "smtp-blocked",
        "port-25",
        "port-587",
        "digitalocean",
        "aws",
        "google-cloud",
        "hetzner",
        "http-api",
        "symfony-mailer",
        "notifications",
        "mailable"
    ],
    "homepage": "https://github.com/lmottasin/laravel-http-mailer",
    "support": {
        "issues": "https://github.com/lmottasin/laravel-http-mailer/issues",
        "source": "https://github.com/lmottasin/laravel-http-mailer"
    },
    "authors": [
        {
            "name": "lmottasin",
            "email": "lmottasin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "symfony/brevo-mailer": "^7.0 || ^8.0",
        "symfony/http-client": "^7.0 || ^8.0",
        "symfony/mailer": "^7.0 || ^8.0",
        "symfony/sendgrid-mailer": "^7.2 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Lmottasin\\HttpMailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lmottasin\\HttpMailer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lmottasin\\HttpMailer\\HttpMailerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
